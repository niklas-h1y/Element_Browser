{
  "manifest_version": 3,
  "name": "DOM Inspector and Modifier Pro",
  "version": "1.0",
  "description": "Select HTML elements visually to change layout properties, styles, and iframe sandbox tokens.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
